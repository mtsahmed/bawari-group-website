# Supabase project URL and anon/public key (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection string, pooled/transaction mode (Supavisor)
# used by Drizzle ORM for all leads/icps/lead_activities queries
DATABASE_URL=

# Apollo.io API key, requires a paid plan with API access
# (used server-only for the "Find Leads" ICP feature)
APOLLO_API_KEY=

# Set to "true" locally to use canned Apollo fixture data instead of
# calling the real API — avoids spending credits while developing.
# Leave unset/false in production.
APOLLO_MOCK=
